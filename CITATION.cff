cff-version: 1.2.0
message: "If you use this software, please cite it using the metadata from this file."
type: software
title: "COLLaiTE Collens"
abstract: >-
  COLLaiTE Collens is a browser-based research software tool for digital manuscript collation and visualization. It supports TEI XML transcriptions, multiple witness comparison, manuscript image synchronization, local browser storage, editorial statistics, and CollateX-based collation workflows for digital humanities research.
version: 0.0.1
date-released: "2025-05-29"
license: Apache-2.0
repository-code: "https://github.com/collaite/collens"
url: "https://collaite.github.io/collens/"
keywords:
  - research-software
  - digital-humanities
  - manuscript-collation
  - TEI-XML
  - textual-criticism
  - digital-philology
  - manuscript-studies
  - CollateX
  - SvelteKit
